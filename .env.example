# Copy to .env and fill in.  main.py loads it automatically (python-dotenv).

# --- Shared credentials (used by BOTH embeddings and the LLM) ----------
# One OpenAI-compatible provider for everything (OpenAI, Gemini, Ollama...).
OPENAI_API_KEY=<place_your_api_key>
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Embeddings ---------------------------------------------------------
# EMBEDDING_BACKEND=auto        # auto | openai | hash (offline dev fallback)
EMBEDDING_MODEL=gemini-embedding-2
# Per-component override (falls back to OPENAI_* when unset):
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=

# --- LLM (answer generation) -----------------------------------
# LLM_BACKEND=auto              # auto | openai | extractive (offline dev fallback)
LLM_MODEL=gemini-3.1-flash-lite         # any model on your OpenAI-compatible endpoint
# LLM_TEMPERATURE=0.2           # low temperature -> factual, deterministic answers
# LLM_MAX_TOKENS=800
# Per-component override (falls back to OPENAI_* when unset). Example —
# OpenAI's open-weight gpt-oss served via Hugging Face Inference Providers
# (chat only; pair with EMBEDDING_BACKEND=hash or Gemini embeddings):
# LLM_API_KEY=hf_...          # HF token with 'Make calls to Inference Providers'
# LLM_BASE_URL=https://router.huggingface.co/v1
# LLM_MODEL=openai/gpt-oss-20b

# --- Weaviate ---------------------------------------------------------
WEAVIATE_MODE=local           # local (docker compose) | embedded (no Docker)
WEAVIATE_HOST=localhost
WEAVIATE_PORT=8080
WEAVIATE_GRPC_PORT=50051
# WEAVIATE_DATA_PATH=./weaviate_data   # embedded mode persistence
RETRIEVAL_WEAK_THRESHOLD=0.80
